{
  "schemaVersion": 1,
  "id": "clientcommands",
  "name": "Client Commands",
  "description": "Useful client-side commands; this fork does not require server opt-in.",
  "version": "${version}",
  "environment": "client",
  "license": "LGPL-3.0-or-later",
  "icon": "assets/clientcommands/icon.png",
  "contact": {
    "homepage": "https://github.com/EvModder/clientcommands",
    "issues": "https://github.com/EvModder/clientcommands/issues",
    "sources": "https://github.com/EvModder/clientcommands"
  },
  "authors": [
    "Earthcomputer"
  ],
  "contributors": [
    "cortex",
    "haykam",
    "xpple"
  ],
  "entrypoints": {
    "client": [
      "net.earthcomputer.clientcommands.ClientCommands"
    ]
  },
  "depends": {
    "minecraft": "${mcversion}",
    "fabricloader": ">=0.18.4",
    "fabric-api": "*",
    "betterconfig": "*",
    "clientarguments": "*",
    "simplewaypoints": "*"
  },
  "mixins": [
    "mixins.clientcommands.json"
  ],
  "accessWidener": "clientcommands.aw"
}
